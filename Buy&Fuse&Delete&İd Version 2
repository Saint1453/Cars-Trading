-- ==================== 4. REMOTES (SUNUCU İLETİŞİMİ) ====================
local Remotes = {}
local Functions = ReplicatedStorage:WaitForChild("Functions", 5)
Remotes.FuseRF = Functions and Functions:WaitForChild("Fuse", 5):WaitForChild("FuseRF", 5)

pcall(function()
    Remotes.CoinMarketRE = ReplicatedStorage:WaitForChild("Events"):WaitForChild("Coin"):WaitForChild("CoinMarketRE")
end)

function Remotes.SafeFuse(id, amount)
    if not Remotes.FuseRF then return false end
    local success, result = pcall(function()
        return Remotes.FuseRF:InvokeServer({[id] = amount})
    end)
    return success and result
end

function Remotes.SafeBuy(id)
    if not Remotes.CoinMarketRE then return false end
    local success = pcall(function()
        Remotes.CoinMarketRE:FireServer("purchase", id, 1)
    end)
    return success
end

