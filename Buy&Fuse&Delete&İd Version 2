-- ==================== 8. EVENT LOOPS (DÖNGÜLER & GÖREVLER) ====================

-- 1. Item ID Finder Döngüsü
AppMaid:GiveTask(task.spawn(function()
    local lastNotifiedItem = nil
    while true do
        task.wait(0.5)
        if State.ItemIDFinderActive then
            local char = LocalPlayer.Character
            if char then
                local foundItem = nil
                for _, child in ipairs(char:GetChildren()) do
                    if child:IsA("Tool") then
                        foundItem = child
                        break
                    end
                end
                
                if foundItem then
                    if foundItem ~= lastNotifiedItem then
                        lastNotifiedItem = foundItem
                        local infoText = "Ad: " .. foundItem.Name
                        if foundItem.TextureId ~= "" then
                            infoText = infoText .. "\nTexture: " .. foundItem.TextureId
                        end
                        pcall(function()
                            StarterGui:SetCore("SendNotification", { Title = "ItemIDFinder", Text = infoText, Duration = 6 })
                        end)
                    end
                else
                    lastNotifiedItem = nil
                end
            end
        else
            lastNotifiedItem = nil
        end
    end
end))

-- 2. Auto Fuse Döngüsü
AppMaid:GiveTask(task.spawn(function()
    while true do
        if State.AutoFuseActive then
            local id = tonumber(State.FuseId)
            local amt = tonumber(State.FuseAmount)
            if id and amt then
                Remotes.SafeFuse(id, amt)
            end
        end
        local customDelay = tonumber(State.FuseDelay) or 0.5
        customDelay = math.clamp(customDelay, 0.1, 5)
        task.wait(customDelay)
    end
end))

