-- 4. Fizik Sıkıştırma Döngüsü
AppMaid:GiveTask(RunService.Stepped:Connect(function()
    if State.PhysicsGlitched then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                for _, part in ipairs(Workspace:GetPartBoundsInRadius(hrp.Position, 4)) do
                    if part and not part:IsDescendantOf(char) and not part.Anchored then
                        part.Velocity = Vector3.new(0, -500, 0)
                        part.RotVelocity = Vector3.new(100, 100, 100)
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end))

