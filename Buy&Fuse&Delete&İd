-- 1. Item ID Finder Döngüsü (Panel Kontrollü)
task.spawn(function()
    local lastNotifiedItem = nil
    while true do
        task.wait(0.5)
        if getgenv().ItemIDFinderActive then
            local char = LocalPlayer.Character
            if char then
                local foundItem = nil
                for _, child in ipairs(char:GetChildren()) do
                    if child:IsA("Tool") then
                        foundItem = child
                        break
                    end
                end
                
                if foundItem then
                    if foundItem ~= lastNotifiedItem then
                        lastNotifiedItem = foundItem
                        local infoText = "Ad: " .. foundItem.Name
                        
                        if foundItem.TextureId ~= "" then
                            infoText = infoText .. "\nTexture: " .. foundItem.TextureId
                        end
                        
                        local handle = foundItem:FindFirstChild("Handle")
                        if handle then
                            if handle:IsA("MeshPart") and handle.MeshId ~= "" then
                                infoText = infoText .. "\nMeshId: " .. handle.MeshId
                            else
                                local mesh = handle:FindFirstChildOfClass("SpecialMesh")
                                if mesh and mesh.MeshId ~= "" then
                                    infoText = infoText .. "\nMeshId: " .. mesh.MeshId
                                end
                            end
                        end
                        
                        pcall(function()
                            StarterGui:SetCore("SendNotification", {
                                Title = "ItemIDFinder",
                                Text = infoText,
                                Duration = 6,
                            })
                        end)
                        print("[Delta ID Finder] " .. infoText)
                    end
                else
                    lastNotifiedItem = nil
                end
            end
        else
            lastNotifiedItem = nil
        end
    end
end)

-- 2. Auto Fuse Döngüsü (Ayarlaç Süre Kontrollü)
task.spawn(function()
    while true do
        if getgenv().AutoFuseActive and FuseRF then
            pcall(function()
                local id = tonumber(FIdBox.Text)
                local amt = tonumber(FAmountBox.Text)
                if id and amt then
                    FuseRF:InvokeServer({[id] = amt})
                end
            end)
        end
        
        -- Süreyi clampleyip güvenli hale getirelim (0.1 ile 5 saniye arası)
        local customDelay = tonumber(FDelayBox.Text)
        if not customDelay or customDelay < 0.1 then customDelay = 0.1 end
        if customDelay > 5 then customDelay = 5 end
        
        task.wait(customDelay)
    end
end)

