local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

print("=== [PROFESSOR: FİZİK ÇAKIŞTIRMA SİSTEMİ BAŞLATILDI] ===")

if PlayerGui:FindFirstChild("PhysicsClipHub") then
    PlayerGui.PhysicsClipHub:Destroy()
end

