CloseBtn.MouseButton1Click:Connect(function()
    _G.PhysicsGlitched = false
    ScreenGui:Destroy()
end)

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, -20, 0, 40)
StatusLabel.Position = UDim2.new(0, 10, 0, 55)
StatusLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 170)
StatusLabel.TextSize = 12
StatusLabel.Font = Enum.Font.Code
StatusLabel.Text = " Durum: Fizik bozucu kapalı."
StatusLabel.Parent = MainFrame

local StatusCorner = Instance.new("UICorner")
StatusCorner.CornerRadius = UDim.new(0, 6)
StatusCorner.Parent = StatusLabel

-- Fizik Bozucu & Harita Altına İtici Döngü
_G.PhysicsGlitched = false

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(1, -20, 0, 50)
ToggleBtn.Position = UDim2.new(0, 10, 0, 115)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 0)
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextSize = 13
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.Text = "🌀 Fizik Çakıştırma Modu (Aç/Kapat)"
ToggleBtn.Parent = MainFrame

local ToggleCorner = Instance.new("UICorner")
ToggleCorner.CornerRadius = UDim.new(0, 6)
ToggleCorner.Parent = ToggleBtn

ToggleBtn.MouseButton1Click:Connect(function()
    _G.PhysicsGlitched = not _G.PhysicsGlitched
    if _G.PhysicsGlitched then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
        StatusLabel.Text = " [⏳] Fizik Modu Aktif! Üstüne bas."

        -- Karakter hız ve ivme fiziğini manipüle etme
        task.spawn(function()
            while _G.PhysicsGlitched do
                RunService.Stepped:Wait()
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local hrp = char.HumanoidRootPart
                        
                        -- Yakındaki nesnelerin fiziğini kırmak için karakterin Velocity değerini yüksek ivmeyle titreştir
                        for _, part in ipairs(Workspace:GetPartBoundsInRadius(hrp.Position, 4)) do
                            if part and not part:IsDescendantOf(char) and not part.Anchored then
                                -- Nesnenin ağ sahipliğini (network ownership) zorla boz ve aşağı doğru hız ver
                                part.Velocity = Vector3.new(0, -500, 0)
                                part.RotVelocity = Vector3.new(100, 100, 100)
                                part.CanCollide = false
                            end
                        end
                    end
                end)
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 80, 0)
        StatusLabel.Text = " [🛑] Fizik Modu Durduruldu."
    end
end)

print("=== [FİZİK ÇAKIŞTIRMA SİSTEMİ HAZIR] ===")
