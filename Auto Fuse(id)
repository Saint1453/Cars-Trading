-- Buton Etkileşimleri (Minimize ve Kapatma)
local isMinimized = false
MinimizeButton.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    ContentFrame.Visible = not isMinimized
    if isMinimized then
        MainFrame.Size = UDim2.new(0, 280, 0, 35)
        MinimizeButton.Text = "+"
    else
        MainFrame.Size = UDim2.new(0, 280, 0, 220)
        MinimizeButton.Text = "-"
    end
end)

CloseButton.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
    getgenv().AutoFuseConfig.Running = false
end)

-- Başlat/Durdur Buton Mantığı
ToggleButton.MouseButton1Click:Connect(function()
    getgenv().AutoFuseConfig.Running = not getgenv().AutoFuseConfig.Running
    if getgenv().AutoFuseConfig.Running then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50) -- Yeşil (Aktif)
        ToggleButton.Text = "Durum: AKTİF"
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Kırmızı (Kapalı)
        ToggleButton.Text = "Durum: KAPALI"
    end
end)

-- Arka Planda Sürekli Çalışan Döngü (Kutulardaki anlık değerleri okur)
task.spawn(function()
    while true do
        if getgenv().AutoFuseConfig.Running and ScreenGui.Parent then
            pcall(function()
                -- Yazılan ID ve Miktar değerlerini sayıya çevir
                local itemId = tonumber(IdBox.Text)
                local amount = tonumber(AmountBox.Text)
                
                if itemId and amount then
                    local exactPayload = {
                        [itemId] = amount 
                    }
                    
                    local response = FuseRF:InvokeServer(exactPayload)
                    if response then
                        StatusLabel.Text = "Başarılı Yanıt Alındı."
                    else
                        StatusLabel.Text = "İstek Gönderildi..."
                    end
                else
                    StatusLabel.Text = "Hata: Geçersiz ID veya Miktar!"
                end
            end)
        end
        task.wait(getgenv().AutoFuseConfig.CheckInterval)
    end
end)

