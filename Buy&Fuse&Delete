-- Arka Planda Çalışan İşlemler (Loop)
task.spawn(function()
    while true do
        -- 1. Auto Fuse İşlemi
        if getgenv().AutoFuseActive and FuseRF then
            pcall(function()
                local id = tonumber(FIdBox.Text)
                local amt = tonumber(FAmountBox.Text)
                if id and amt then
                    FuseRF:InvokeServer({[id] = amt})
                end
            end)
        end
        
        -- 2. Auto Buy İşlemi
        if getgenv().AutoBuyActive and CoinMarketRE then
            pcall(function()
                local id = tonumber(BIdBox.Text)
                if id then
                    CoinMarketRE:FireServer("purchase", id, 1)
                end
            end)
        end
        
        task.wait(0.2)
    end
end)

-- 3. Fizik Sıkıştırma Döngüsü
task.spawn(function()
    while true do
        RunService.Stepped:Wait()
        if _G.PhysicsGlitched then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    for _, part in ipairs(Workspace:GetPartBoundsInRadius(hrp.Position, 4)) do
                        if part and not part:IsDescendantOf(char) and not part.Anchored then
                            part.Velocity = Vector3.new(0, -500, 0)
                            part.RotVelocity = Vector3.new(100, 100, 100)
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    end
end)

